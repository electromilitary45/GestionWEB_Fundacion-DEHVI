@model Fundacion_Dehvi.Entities.UsuarioEnt

@{
    Layout = "~/Views/Shared/_LayoutLogin.cshtml";
    ViewBag.Title = "InicioSesion";
}

<!-- Section -->
<section class="fullscreen" data-bg-video="/Src/video/backgroundninos.mp4">
    <div class="video-overlay"></div>
    <div class="container">
        <div>
            <div class="row">
                <div class="col-lg-5 center p-50 b-r-6" style="background-color:#ECE9E6;">
                    <div class="text-center m-b-30">
                        <a href="@Url.Action("Index","Home")" class="logo">
                            <img src="~/Src/image/icons/logo-horizontal.png" alt="Logo Fundacion DEHVI" width="300">
                        </a>
                    </div>
                    <h4>Inicie sesion en su cuenta.</h4>
                    <hr />
                    <br />
                    @using (Html.BeginForm("InicioSesion", "Login", FormMethod.Post, new { @class = "pt-3" }))
                    {
                        if (ViewBag.mensaje != null)
                        {
                            <div class="alert alert-primary" role="alert">
                                @ViewBag.mensaje
                            </div>
                        }
                        <div class="form-group">
                            <label class="sr-only">Correo Electronico</label>
                            @Html.TextBoxFor(model => model.correo, new {@class = "form-control", placeholder = "Correo", required = "required", @type = "email", pattern = @"[a-zA-Z0-9._%+-]+@dehvi.org", title = "El correo electrónico debe pertenecer al dominio @dehvi.org"})
                        </div>
                        <div class="form-group m-b-5">
                            <label class="sr-only">Contraseña</label>
                            @Html.PasswordFor(model => model.contrasena, new { @class = "form-control", placeholder = "Contraseña", required = "required" })
                        </div>
                        <div class="text-center form-group">
                            <button type="submit" class="btn">Iniciar sesion</button>
                        </div>
                    }
                    <p class="small">
                        Olvidaste tu contraseña? <a href="@Url.Action("RecuperarContrasena","Login")">Recuperar contraseña.</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .fullscreen {
        position: relative;
        width: 100%;
        height: 100vh;
        overflow: hidden;
    }

        .fullscreen::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            background: url('/Src/video/backgroundninos.mp4') no-repeat center center/cover;
            filter: blur(10px);
            z-index: -1;
        }

    .video-overlay {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: rgba(0, 0, 0, 0.5);
        z-index: -1;
    }

    .container {
        position: relative;
        z-index: 1;
    }
</style>

<!-- end: Section -->
