<!DOCTYPE html>
<html lang="es-mx">
<head>
    <!--ETIQUETAS PARA COMPATIBILIDAD-->
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge">

    <!--DESCRICIONES-->
    <meta name="description" content="Fundación Dehvi" />
    <meta name="author" content="ElectroMilitary45" />
    <meta name="author" content="marivonherold" />

    <!--ICON-->
    <link rel="icon" type="image/png" href="~/Src/image/icons/">

    <!--TITULO-->
    <title>Fundación Dehvi</title>

    <!--Hojas de estilos & Fuentes-->
    <link href="~/Src/css/plugins.css" rel="stylesheet" />
    <link href="~/Src/css/style.css" rel="stylesheet" />

</head>
<body>

    <!--Inicio: Interior del cuerpo-->
    <div class="body-inner">

        <!--Inicio: Barra de navegacion-->
        <header id="header" data-fullwidth="true" class="header-alternative">
            <div class="header-inner">
                <div class="container">

                    <!--Inicio: Logo-->
                    <div id="logo">
                        <a href="#">
                            <img src="~/Src/image/icons/ico-fundacion_v1.png" class="logo-default" />
                        </a>
                    </div>
                    <!--Fin: Logo

                    <!--Inicio: Activacion Responsive-->
                    <div id="mainMenu-trigger">
                        <a class="lines-button x"><span class="lines"></span></a>
                    </div>
                    <!--end: Activacion Responsive-->

                    <!--Inicio: Navegacion-->
                    <div id="mainMenu" class="menu-left menu-lowercase">
                        <div class="container">
                            <nav>
                                <ul>
                                    <li><a href="">Inicio</a></li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <!--Fin: Navegacion-->
                </div>
            </div>

        </header>
        <!--Fin: Barra de navegacion-->

        <!--Inicio: Contenido renderizado-->
        @RenderBody()
        <!--Fin: Contenido renderizado-->

        <!--Inicio: Footer-->
    <footer id="footer">
        <div class="copyright-content">
            <div class="container">
                <div class="row">                    
                    <div class="col-lg-12">
                        <div class="copyright-text text-center">&copy; @DateTime.Now.Year Fundación DEHVI. Todos los Derechos Reservados.<a href="https://dehvi.org/" target="_blank" rel="noopener"> Fundación DEHVI</a> </div>
                    </div>
                </div>
            </div>
        </div>
    </footer>
        <!--Fin: Footer-->
    </div>
    <!--Fin: Interior del cuerpo-->
    <!-- Scroll top -->
    <a id="scrollTop"><i class="icon-chevron-up"></i><i class="icon-chevron-up"></i></a>

    <!--Plugins-->
    <script src="~/Src/js/jquery.js"></script>
    <script src="~/Src/js/plugins.js"></script>

    <!--Funciones del template-->
    <script src="~/Src/js/functions.js"></script>
</body>
</html>
