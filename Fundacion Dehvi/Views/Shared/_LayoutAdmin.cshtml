<!DOCTYPE html>
<html lang="es">

<head>
    <link rel="icon" type="image/png" href="~/Src/images/logos/Logo-GruasSRL.jpg">
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="content-type" content="text/html; charset=utf-8" />

    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <!-- Document title -->
    <title>@ViewBag.Title</title>
    <!-- Stylesheets & Fonts -->
    <link href="~/Src/css/plugins.css" rel="stylesheet">
    <link href="~/Src/css/style.css" rel="stylesheet">
    <link href="~/Src/plugins/pageloader/pageloader.css" rel="stylesheet">
    <link href="~/Src/css/custom.css" rel="stylesheet">

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    @if (ViewBag.Title == "IndexPrincipal")
    {
        <link href="~/Src/css/custom.css" rel="stylesheet">
    }
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href='~/Src/plugins/datatables/datatables.min.css' rel='stylesheet' />
</head>

<body>
    <!-- Body Inner -->
    <div class="body-inner">
        <header id="header" data-fullwidth="true" class="header-alternative light" data-responsive-fixed="true" style=" box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); ">
            <div class="header-inner" style=" box-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2); ">
                <div class="container">
                    <!--Logo-->
                    <div id="logo">
                        <a href="@Url.Action("Index","Home")">
                            <img src="~/Src/image/icons/2.png" class="logo-default" alt="Logo">
                        </a>
                    </div>  
                    <!--End: Logo-->
                    <!-- Search -->
                    <div id="search">
                        <a id="btn-search-close" class="btn-search-close" aria-label="Cerrar busqueda"><i class="icon-x"></i></a>
                        <form class="col-12, search-form" id="widget-search-form-sidebar" style="max-width: 600px; width: 100%; margin: 0 auto;" action="@Url.Action("Buscar", "Procedimiento")" method="get">
                                <input class="form-control" name="term" type="text" placeholder="Buscar procedimientos..." />
                                <span class="text-muted">Presiona "Enter" para buscar o "ESC" para cerrar esta pantalla</span>
                            </form>
                    </div>
                    <!-- end: search -->
                    <!--Header Extras-->
                    <div class="header-extras">
                        <ul>
                            <li><a id="btn-search" href="#"> <i class="icon-search" style="font-size:16px"></i></a></li>
                            <li>
                                <div class="p-dropdown">
                                    <a><i class="fa fa-user-circle" style="font-size:20px"></i></a>
                                    <div class="p-dropdown-content">
                                        <div class="widget-myaccount">
                                            @if (Session["idUsuario"] != null)
                                            {
                                                <div class="d-block">
                                                    @if (Session["rutaImg"] != null)
                                                    {
                                                        <img class="avatar avatar-lg" src="@Session["rutaImg"]" alt="User Image">
                                                    }
                                                    else
                                                    {
                                                        <img class="avatar avatar-lg" src="~/Src/image/usuario/foto-perfil.jpg" alt="Default User Image">
                                                    }
                                                </div>
                                                <span>@Session["nombre"] @Session["apellido1"] @Session["apellido2"]</span>
                                            }
                                            <ul class="text-center">
                                                @if (Session["idUsuario"] == null)
                                                {
                                                    <li><a href="@Url.Action("InicioSesion","Login")"><i class="icon-log-in"></i>Inicio de Sesion</a></li>
                                                }
                                                else
                                                {
                                                    <li><a href="@Url.Action("PerfilUsuario", "Usuario")"><i class="icon-user"></i>Mi perfil</a></li>
                                                    <li><a href="@Url.Action("CerrarSesion","Login")"><i class="icon-log-out"></i>Cerrar Sesion</a></li>
                                                }
                                            </ul>
                                        </div>
                                    </div>
                                </div>
                            </li>
                        </ul>
                    </div>
                    <!-- end: Header Extras-->
                    <!--Navigation Resposnive Trigger-->
                    <div id="mainMenu-trigger">
                        <a class="lines-button x"><span class="lines"></span></a>
                    </div>
                    <!--end: Navigation Resposnive Trigger-->
                    <!--Navigation-->
                    <div id="mainMenu" class="menu-center menu-lowercase">
                        <div class="container">
                            <nav>
                                <ul>
                                    <li><a href="@Url.Action("Index", "Home")">Home</a></li>
                                    @if (Session["idUsuario"] != null)
                                    {
                                        <li><a href="@Url.Action("PerfilDepa", "Departamento", new { q = Session["idDepartamento"] })">Mi Departamento</a></li>
                                        <!-- Renderiza la lista de departamentos aquí -->
                                        @Html.Action("NavBar", "Home")
                                        <!-- Renderiza la lista de departamentos aquí -->
                                        <li class="dropdown">
                                            <a href="#">Usuarios</a>
                                            <ul class="dropdown-menu">
                                                <li><a href="@Url.Action("ListaUsuariosAdmin","Usuario")">Lista de Usuarios</a></li>
                                                <li><a href="@Url.Action("NuevoUsuarioAdmin","Usuario")">Agregar Usuarios</a></li>
                                            </ul>
                                        </li>
                                        <li class="dropdown">
                                            <a href="#">Procedimientos</a>
                                            <ul class="dropdown-menu">
                                                <li><a href="@Url.Action("ListaProces", "Procedimiento")">Todos los Procedimientos</a></li>
                                                <li><a href="@Url.Action("CrearProce", "Procedimiento")">Agregar Procedimiento</a></li>
                                            </ul>
                                        </li>
                                        <li><a href="@Url.Action("ConsultaManuales", "Manual")">Manuales</a></li>
                                    }
                                </ul>
                            </nav>
                        </div>
                    </div>
                    <!--end: Navigation-->
                </div>
            </div>
        </header>
        <!-- end: Header -->
        <!-- BODY -->

        @RenderBody()

        <!-- FIN BODY -->
        <!-- Footer -->
        <footer id="footer">
            <div class="copyright-content">
                <div class="container">
                    <div class="copyright-text text-center">&copy; @DateTime.Today.Year Fundación DEHVI. Derechos Reservados               <a href="https://dehvi.org/" target="_blank" rel="noopener">                       FUNDACIÓN DEHVI</a> </div>
                </div>
            </div>
        </footer>
        <!-- end: Footer -->
    </div>
    <!-- end: Body Inner -->
    <!-- Scroll top -->
    <a id="scrollTop"><i class="icon-chevron-up"></i><i class="icon-chevron-up"></i></a>

    <!--Plugins-->
    <script src="~/Src/js/jquery.js"></script>
    <script src="~/Src/js/plugins.js"></script>
    <script src="~/Src/js/functions.js"></script>
    <script src='~/Src/plugins/datatables/datatables.min.js'></script>
    <script src="~/Src/plugins/popper/popper.min.js"></script>


    <script src="~/Src/plugins/pageloader/pageloader.init.js"></script>
    <script src="~/Src/plugins/pageloader/pageloader.js"></script>
    @*<script src="~/Src/plugins/particles/particles.js" type="text/javascript"></script>
        <script src="~/Src/plugins/particles/particles-dots.js" type="text/javascript"></script>
        <script src="~/Src/plugins/particles/particles-stars.js" type="text/javascript"></script>
        <script src="~/Src/plugins/particles/particles-bubble.js" type="text/javascript"></script>*@

    <!--Funciones Personalizadas-->
    <script src="~/Src/funciones/FuncionesUsuarios.js"></script>
