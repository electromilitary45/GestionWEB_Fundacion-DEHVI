@model IEnumerable<Fundacion_Dehvi.Entities.DepartamentoEnt>

<li class="dropdown">
    <a href="#">Departamentos</a>
    <ul class="dropdown-menu">
        <li><a href="@Url.Action("ListaDepartasAdmin", "Departamento")">Admin Departamentos</a></li>
        <li><a href="@Url.Action("ListaDeparta", "Departamento")">Todos los Departamentos</a></li>
        <li><a href="@Url.Action("CrearDepartamento", "Departamento")">Agregar Departamento</a></li>
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                if (item.estado == true)
                {
                    <li class="dropdown-submenu">
                        <span class="dropdown-menu-title-only">@item.nombre</span>
                        <ul class="dropdown-menu">
                            <li><a href="@Url.Action("ListaProcesSector", "Procedimiento", new { q = item.idDepartamento })">Procedimientos</a></li>
                            <li><a href="page-about-extended.html">Manuales</a></li>
                            <li><a href="page-about-extended.html">Usuarios del Sector</a></li>
                        </ul>
                    </li>
                }

            }
        }
    </ul>
</li>