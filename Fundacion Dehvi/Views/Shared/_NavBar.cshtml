@model IEnumerable<Fundacion_Dehvi.Entities.DepartamentoEnt>

@{
    int idRol = Convert.ToInt32(Session["idRol"]);
}

<li class="dropdown">
    <a href="#">Departamentos</a>
    <ul class="dropdown-menu">
        @if (idRol == 1)
        {
            <li><a href="@Url.Action("ListaDepartasAdmin", "Departamento")">Admin Departamentos</a></li>
            <li><a href="@Url.Action("CrearDepartamento", "Departamento")">Agregar Departamento</a></li>
            <li><hr class="divider" /> </li>

        }
        else if (idRol == 2)
        {
            <li><a href="@Url.Action("CrearDepartamento", "Departamento")">Agregar Departamento</a></li>
            <li><hr class="divider" /> </li>

        }
        else
        {
        }
        @if (Model != null)
        {
            foreach (var item in Model)
            {
                if (item.estado == true)
                {
                    <li class="dropdown-submenu">
                        <span class="dropdown-menu-title-only">@item.nombre</span>
                        <ul class="dropdown-menu">
                            <li><a href="@Url.Action("PerfilDepa", "Departamento", new { q = item.idDepartamento })">Procedimientos</a></li>
                            <li><a href="@Url.Action("ListaUsuariosDep", "Usuario", new {q=item.idDepartamento})">Usuarios del Departamento</a></li>
                        </ul>
                    </li>
                }

            }
        }
    </ul>
</li>