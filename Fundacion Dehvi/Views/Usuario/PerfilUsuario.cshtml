@model IEnumerable<Fundacion_Dehvi.Entities.Manual_Ent>
@{
    ViewBag.Title = "Perfil de Usuario";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var idRol = byte.Parse(Session["idRol"].ToString());

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            case 2://jefaruta
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            default: //todos sin permisos
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
        }
    }
}

<!-- Page title -->
<section id="page-title" class="text-light" style="background-image:url('../../Src/image/imagenes/banner 6.png'); background-size: cover; background-position: center center;">
@*<div class="container">
        <div class="page-title">
            <h1>@Session["nombre"] @Session["apellido1"] @Session["apellido2"]</h1>
        </div>
    </div>
    <div style="">
        <img src="~/Src/image/usuario/foto-perfil.jpg" width="200" />
    </div>*@
</section>
<!-- end: Page title -->
<!-- Page Content -->
<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">
            <!-- content -->
            <div class="content col-lg-9">
                <!--Inicio: Informacion Personal-->
                <div>
                    <div class="container">
                        <div class="row">
                            <h3>@Session["nombre"] @Session["apellido1"] @Session["apellido2"]</h3>
                        </div>
                    </div>
                    <hr />
                    <div class="container">
                        <div class="row">
                            <div class="col-md-4">
                                <span><i class="icon-clock"></i> Tiempo en la empresa</span>
                                @{
                                    DateTime fechaCreacion = DateTime.Parse(Session["fechaCreacion"].ToString());
                                    DateTime fechaActual = DateTime.Now;
                                    TimeSpan tiempoTranscurrido = fechaActual - fechaCreacion;

                                    int annos = (int)(tiempoTranscurrido.Days / 365.25);
                                    int meses = (int)((tiempoTranscurrido.Days % 365.25) / 30);
                                    int dias = (int)((tiempoTranscurrido.Days % 365.25) % 30);
                                }
                                <p>Años: @annos, Meses: @meses, Dias: @dias</p>
                            </div>
                        </div>
                    </div>
                    <br />
                    <div class="container">
                        <div class="row">
                            <div class="col-md-6">
                                <span><i class="icon-mail"></i> Correo Electronico @idRol</span>
                                <p>@Session["correo"]</p>
                            </div>
                            <div class="col-md-6">
                                <span><i class="icon-home"></i> Empleado Del Departamento:</span>
                                <p>@Session["nomDepartamento"]</p>
                            </div>
                        </div>
                    </div>
                </div>
                <!---->

                <div class="line"></div>
                <!--Inicio: Tabs-->
                @if (idRol == 1 || idRol == 2)
                {
                    if (Model != null)
                    {
                        <h6><i class="icon-book"></i> Manuales Creados</h6>
                        foreach (var item in Model)
                        {
                            <!--CAROUSEL-->
                            <div class="carousel" data-items="3">
                                <div class="post-item border">
                                    <div class="post-item-wrap">
                                        <div class="post-image">
                                            <a href="@Url.Action("PerfilManualAdmin", "Manual", new {q=item.idManual})">
                                                <img alt="predeterminada" src="~/Src/image/Archivos/archivo-predeterminado.png" />
                                            </a>
                                        </div>
                                        <div class="post-item-description">
                                            <span class="post-meta-date"><i class="fa fa-flag"></i>@item.codReferencia</span>
                                            <h6><a href="@Url.Action("PerfilManualAdmin", "Manual", new {q=item.idManual})">@item.nombre</a></h6>
                                            <a href="@Url.Action("PerfilManualAdmin", "Manual", new {q=item.idManual})" class="item-link">Ir al perfil<i class="icon-chevron-right"></i></a>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <!--Fin carousel-->
                        }
                    }
                    else
                    {
                        <div class="alert-container" style="display: flex; align-items: center; justify-content: center; padding: 20px; background-color: #f0f8ff; border: 1px solid #b8daff; border-radius: 10px;">
                            <img src="~/Src/image/procedimientos/chiquito-binoculares.png" style="width: 100px; height: auto; margin-right: 20px;">
                            <div role="alert" class="alert alert-info" style="flex: 1; background-color: #d1ecf1; color: #0c5460; border-color: #bee5eb; padding: 20px; border-radius: 10px;">
                                <h4 style="margin-top: 0;">No se encontraron manuales.</h4>
                                <p>Lo sentimos, no pudimos encontrar manuales. Por favor, inténtelo de nuevo más tarde.</p>
                            </div>
                        </div>
                    }

                }

                <!--Fin TABS-->

            </div>
            <!-- end: content -->
            <!-- Sidebar-->
            <div class="sidebar col-lg-3">
                <div class="widget widget-myaccount p-cb">
                    <div class="d-block">
                        @if (Session["rutaImg"] != null)
                        {
                            <img class="" src="@Session["rutaImg"]" width="150">
                        }
                        else
                        {
                            <img class="" src="~/Src/image/usuario/foto-perfil.jpg" width="150">
                        }
                    </div>
                    <br />

                    <ul class="text-left">
                        <li><a href="@Url.Action("EditarMiAvatar","Usuario")"><i class="icon-camera"></i>Editar mi avatar</a></li>
                        <li><a href="@Url.Action("EditarMisDatos","Usuario")"><i class="icon-edit-3"></i>Editar mis datos</a></li>
                        <li><a href="@Url.Action("CambioContrasena","Usuario")"><i class="icon-shield"></i>Cambiar mi contraseña.</a></li>
                        <li><a href="@Url.Action("CerrarSesion","Login")"><i class="icon-log-out"></i>Cerrar Sesion</a></li>
                    </ul>
                </div>


            </div>
            <!-- end: sidebar-->

        </div>
    </div>
</section>
<!-- end: Page Content -->
