@model Fundacion_Dehvi.Entities.UsuarioEnt

@{
    ViewBag.Title = "Editando mis Datos";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var idRol = byte.Parse(Session["idRol"].ToString());

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;

            default: //empleaods
                Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
                break;
        }
    }
}

<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image:url('../../Src/image/imagenes/banner 6.png'); background-size: cover; background-position: center center;"></section>
<!--FIN: Page Tittle-->

<section id="page-content">
    <div class="container">
        <!--BTN retroceder-->
        <a class="btn btn-rounded" href="@Url.Action("PerfilUsuario","Usuario")"><i class="icon-arrow-left"></i> Mi Perfil </a>

        <!--INICIO: Alertas-->
        @if (ViewBag.mensaje != null)
        {
            <div class="container">
                <div role="alert" class="alert alert-info alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span> </button>
                    <strong><i class="fa fa-check-circle"></i> Warning!</strong> @ViewBag.mensaje
                </div>
            </div>
        }
        <!--FIN: Alertas-->
        <!--Datos de cuenta-->
        <div class="card">
            <div class="card-header">
                <span class="h4">Detalles de mi Cuenta.</span>
                <p class="text-muted">
                    Recibiras una notificacion en caso de realizar un cambio en esta seccion.
                </p>
            </div>

            <div class="card-body">
                @using (Html.BeginForm("EditarMisDatos", "Usuario", FormMethod.Post, new { @class = "form-validate pt-3" }))
                {
                    @Html.TextBoxFor(m => m.idUsuario, new { @type = "hidden" })
                    <div class="h5 mb-4">Informacion Personal</div>
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Cedula Fisica</label>
                            @Html.TextBoxFor(m => m.cedulaFisica, new { @class = "form-control", @readonly = "readonly", @required = "required", @placeholder = "Cedula Fisica" })
                        </div>
                    </div>
                    <div class="form-row">
                        <div class="form-group col-md-4">
                            <label>Nombre</label>
                            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", @readonly = "readonly", @required = "required", @placeholder = "Nombre" })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Primer Apellido</label>
                            @Html.TextBoxFor(m => m.apellido1, new { @class = "form-control", @readonly = "readonly", @required = "required", @placeholder = "Primer Apellido" })
                        </div>
                        <div class="form-group col-md-4">
                            <label>Segundo Apellido</label>
                            @Html.TextBoxFor(m => m.apellido2, new { @class = "form-control", @readonly = "readonly", @required = "required", @placeholder = "Segundo Apellido" })
                        </div>
                    </div>
                    <hr />
                    <div class="form-row">
                        <div class="form-group col-md-6">
                            <label>Correo Electronico</label>
                            @Html.TextBoxFor(m => m.correo, new { @class = "form-control", @readonly = "readonly", @required = "required", @placeholder = "Cedula Fisica" })

                        </div>
                    </div>

                    <div class="text-center form-group" style="margin:20px;">
                        <button type="submit" class="btn" disabled>Actualizar mis datos</button>
                    </div>
                }

            </div>
        </div>
    </div>
</section>
