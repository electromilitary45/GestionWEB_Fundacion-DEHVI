@model IEnumerable<Fundacion_Dehvi.Entities.UsuarioEnt>
@{
    ViewBag.Title = "Lista de Usuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image:url(../../Src/image/usuario/background.jpg); background-size: cover; background-position: center center;"></section>
<!--FIN: Page Tittle-->
<!--INICIO: Page Content-->
<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">

            <div class="col-lg-9">
                <!--INICIO: Tabla-->

                <div class="container">
                    @if (ViewBag.mensaje != null)
                    {

                        <div class="alert alert-primary" role="alert">
                            @ViewBag.mensaje
                        </div>
                    }
                    <div class="row team-members m-b-30">

                        @foreach (var u in Model)
                        {

                            <div class="col-lg-4">
                                <div class="team-member" style="background-color: #808080; border-radius: 20px; ">
                                    <div class="team-image">
                                        @if (u.rutaImg != null)
                                        {
                                            <img src="@u.rutaImg" height="225" width="350" style="background-size:cover; background-position:center; background-repeat:no-repeat;">
                                        }
                                        else
                                        {
                                            <img src="~/Src/image/usuario/foto-perfil.jpg" height="225" width="350" style="background-size:cover; background-position:center; background-repeat:no-repeat;">
                                        }
                                    </div>
                                    <div class="team-desc text-left">
                                        <div class="row text-right">
                                            <div class="col-lg-1">
                                                @if (u.estado == true)
                                                {
                                                    <a href="@Url.Action("DesactivarUsuario","Usuario", new {q=u.idUsuario})"><i class="icon-toggle-right" style="color: #000000;"></i></a>
                                                }
                                                else
                                                {
                                                    <a href="@Url.Action("ActivarUsuario","Usuario", new {q=u.idUsuario})"><i class="icon-toggle-left" style="color: #000000;"></i></a>
                                                }
                                            </div>
                                            <div class="col-lg-1">
                                                <a href="@Url.Action("EditarUsuarioAdmin","Usuario", new {q=u.idUsuario})"><i class="icon-edit" style="color: #000000"></i></a>
                                            </div>
                                        </div>
                                        <h6 style="color:white">@u.nombre @u.apellido1 @u.apellido2</h6>
                                        <span style="color: #3B3B3B;">Departamento</span>
                                        <br />
                                        <span style="color:#FFFFFF">@u.nombreDepartamento</span>
                                    </div>
                                </div>
                            </div>
                        }

                    </div>
                </div>
                <!--FIN: TAbla-->
            </div>
            <!--Sidebar-->
            <div class="sidebar col-lg-3">
                <a href="@Url.Action("NuevoUsuarioAdmin","Usuario")" class="btn btn-rounded"><i class="fa fa-user-plus"></i> Nuevo Usuario</a>
            </div>
        </div>
    </div>


</section>
<!--FIN: Page Content-->
