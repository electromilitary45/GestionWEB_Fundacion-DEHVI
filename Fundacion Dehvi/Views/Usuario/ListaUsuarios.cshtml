@model IEnumerable<Fundacion_Dehvi.Entities.UsuarioEnt>
@{
    ViewBag.Title = "ListaUsuarios";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}

<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image:url(../../Src/image/usuario/background.jpg); background-size: cover; background-position: center center;"></section>
<!--FIN: Page Tittle-->
<!--INICIO: Page Content-->
<section id="page-content">
    <!--INICIO: Tabla-->
    <div class="container">
        <div class="row team-members m-b-40">
            @foreach (var u in Model)
            {
                
                <div class="col-lg-3">
                    <div class="team-member">
                        <div class="team-image">
                            @if (u.rutaImg != null)
                            {
                                <img src="@u.rutaImg" height="100" width="100">
                            }
                            else
                            {
                                <img src="~/Src/image/usuario/foto-perfil.jpg" height="100" width="100">
                            }


                        </div>
                        <div class="team-desc text-left">
                            <h6>@u.nombre @u.apellido1 @u.apellido2</h6>
                            <span>@u.nombreDepartamento</span>
                            <p>The most happiest time of the day!. Praesent tristique hendrerit ex ut laoreet. </p>
                            <div class="align-center">
                                <a class="btn btn-xs btn-slide btn-light" href="#">
                                    <i class="fab fa-facebook-f"></i>
                                    <span>Facebook</span>
                                </a>
                                <a class="btn btn-xs btn-slide btn-light" href="#" data-width="100" style="width: 28px;">
                                    <i class="fab fa-twitter"></i>
                                    <span>Twitter</span>
                                </a>
                                <a class="btn btn-xs btn-slide btn-light" href="#" data-width="118">
                                    <i class="fab fa-instagram"></i>
                                    <span>Instagram</span>
                                </a>
                                <a class="btn btn-xs btn-slide btn-light" href="mailto:#" data-width="80">
                                    <i class="icon-mail"></i>
                                    <span>Mail</span>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }

        </div>
    </div>
    <!--FIN: TAbla-->
</section>
<!--FIN: Page Content-->
