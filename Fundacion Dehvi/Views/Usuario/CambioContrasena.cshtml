@model Fundacion_Dehvi.Entities.UsuarioEnt

@{
    ViewBag.Title = "Cambio de Contrasena";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var idRol = byte.Parse(Session["idRol"].ToString());

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            case 2://jefaruta
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            default: //todos sin permisos
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
        }
    }
}

<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image:url(../../Src/image/usuario/background.jpg); background-size: cover; background-position: center center;"></section>
<!--FIN: Page Tittle-->

<section id="page-content">
    <div class="container">
        <!--BTN retroceder-->
        <a class="btn btn-rounded" href="@Url.Action("PerfilUsuario","Usuario")"><i class="icon-arrow-left"></i> Mi Perfil </a>
        
        <!--INICIO: Alertas-->
        @if (ViewBag.mensaje != null)
        {
            <div class="container">
                <div role="alert" class="alert alert-info alert-dismissible">
                    <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span> </button>
                    <strong><i class="fa fa-check-circle"></i> Warning!</strong> @ViewBag.mensaje
                </div>
            </div>
        }
        <!--FIN: Alertas-->

        <div class="card">
            <div class="card-header">
                <span class="h4">Cambia tu contraseña. @Html.DisplayTextFor(m => m.nombre)</span>
                <p class="text-muted">Cambia la contraseña de tu cuenta.</p>
            </div>


            <div class="card-body">
                <!--INICIO: formulario-->
                <form method="post" asp-controller="Usuario" asp-action="CambioContrasena">
                    <input type="hidden" name="idUsuario" value="@Session["idUsuario"].ToString()" />
                    <!--INICIO: Contraseña Actual-->
                    <div class="row">
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label">Contraseña Actual</label>
                                <div class="input-group show-hide-password">
                                    <input class="form-control" required placeholder="Contraseña Actual" type="password" name="contrasenaActual" />
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-eye-off" aria-hidden="true" style="cursor: pointer;"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <!--FIN: Contraseña Actual-->


                    <div class="row">
                        <!--INICIO: Nueva Contraseña-->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label">Nueva Contraseña</label>
                                <div class="input-group show-hide-password">
                                    <input class="form-control" required placeholder="Nueva Contraseña" type="password" name="contrasenaNueva" />
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-eye-off" aria-hidden="true" style="cursor: pointer;"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--FIN: Nueva Contraseña-->
                        <!--INICIO: Repetir Contraseña-->
                        <div class="col-md-6">
                            <div class="form-group">
                                <label class="form-control-label">Repetir Contraseña</label>
                                <div class="input-group show-hide-password">
                                    <input class="form-control" required placeholder="Repetir Contraseña" type="password" name="contrasenaRepetida" />
                                    <div class="input-group-append">
                                        <span class="input-group-text"><i class="icon-eye-off" aria-hidden="true" style="cursor: pointer;"></i></span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <!--FIN: Repetir Contraseña-->
                    </div>
                    <div class="mt-4 text-center">
                        <button type="submit" class="btn btn-md" name="btnSubmit">Actualizar Contraseña <i class="icon-check"></i></button>
                    </div>
                </form>
                
                <!--FIN: Formulario-->
            </div>
        </div>
    </div>
</section>