@using System.Text.RegularExpressions;

@model Tuple<Fundacion_Dehvi.Entities.Manual_Ent, IEnumerable<Fundacion_Dehvi.Entities.DocManual_Ent>>
@{
    ViewBag.Title = "PerfilManual";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
    var primerItem = Model.Item2.FirstOrDefault();
    long idProcedimiento = ViewBag.idProcedimiento;

    byte idRol;
    byte.TryParse(Session["idRol"]?.ToString(), out idRol);

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;

            default: //empleaods
                Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
                break;
        }
    }
}


<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image: url('../../Src/image/imagenes/banner 5.png');; background-size: cover; background-position: center center;">
    <div class="bg-overlay" data-style="1"></div>
</section>
<!--FIN: Page Tittle-->
<!--INICIO: Contenido-->
<section id="page-content">
    <!--INICIO: BTN Retorceder-->
    <div class="container">
        <a class="btn btn-rounded" href="@Url.Action("PerfilProce", "Procedimiento", new { q=idProcedimiento })"><i class="icon-arrow-left"></i> Perfil del Procedimiento</a>
    </div>
    <!--Fin: BTN Retorceder-->

    <div class="container">
        <div class="row">


            <div class="col-lg-4">
                @{
                    Regex regex = new Regex(@"\.(pdf|docx|xlsx|pptx)$", RegexOptions.IgnoreCase);

                    Match match = regex.Match(primerItem.ruta);

                    // Usar switch para determinar la extensión
                    switch (match.Value.ToLower())
                    {
                        case ".pdf":
                            <a href="@primerItem.ruta"><img src="~/Src/image/Archivos/pdf.jpg" width="250" /></a>
                            
                            break;
                        case ".docx":
                            <img src="~/Src/image/Archivos/word.jpg" width="250" />
                            break;
                        case ".xlsx":
                            <img src="~/Src/image/Archivos/excel.jpg" width="250" />
                            break;
                        case ".pptx":
                            <img src="~/Src/image/Archivos/ppt.jpg" width="250" />
                            break;
                        default:
                            <img src="~/Src/image/Archivos/archivo-predeterminado.png" width="250" />
                            break;
                    }
                }

            </div>
            <div class="col-lg-8">

                @if (ViewBag.mensaje != null)
                {
                    <div class="container">
                        <div role="alert" class="alert alert-info alert-dismissible">
                            <button type="button" class="close" data-dismiss="alert" aria-label="Close"><span aria-hidden="true">×</span> </button>
                            <strong><i class="fa fa-check-circle"></i> Alerta!</strong> @ViewBag.mensaje
                        </div>
                    </div>
                }

                <!--Boton para descargar-->
                <div class="row">
                    <div class="col-lg-3">
                        <a href="@primerItem.ruta" class="btn btn-success btn-icon-holder btn-shadow btn-light-hover">Descargar<i class="fa fa-cloud-download-alt"></i> </a>
                    </div>
                </div>

                <hr />
                <!--FECHA ULTIMA ACTUALIZACION-->
                <div class="">
                    <h5><i class="icon-calendar"></i> Fecha de Creacion/Actualizacion</h5>
                    <p>@primerItem.fechaCreacion</p>
                </div>
                <!--Usuario-->
                <div class="">
                    <h5><i class="icon-user"></i> Usuario Creador</h5>
                    <p>@primerItem.nombreUsuario</p>
                </div>



                <hr />
                <!--INICIO: Acordion-->
                <div class="toggle accordion accordion-shadow">
                    <div class="ac-item">
                        <h6 class="ac-title"><i class="fa fa-rocket"></i> Versiones </h6>
                        <div class="ac-content" style="display: none;">
                            <table class="table">
                                <thead>
                                    <tr>
                                        <th scope="col">Version</th>
                                        <th scope="col">Fecha de Actualizacion</th>
                                        <th scope="col">Usuario que actualizo</th>
                                        <th scope="col">Acciones</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.Item2)
                                    {
                                        if (item.estado == true)
                                        {
                                            <tr class="table-primary">
                                                <td>@item.versionDoc</td>
                                                <td>@item.fechaCreacion</td>
                                                <td><i class="fa fa-user"></i> @item.nombreUsuario</td>
                                                <td><a href="@item.ruta"><i class="fa fa-cloud-download-alt"></i> Descargar</a></td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr class="">
                                                <td>@item.versionDoc</td>
                                                <td>@item.fechaCreacion</td>
                                                <td><i class="fa fa-user"></i> @item.nombreUsuario</td>
                                                <td><a href="@item.ruta"><i class="fa fa-cloud-download-alt"></i> Descarga</a></td>
                                            </tr>
                                        }
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
                <!--FIN: Acordion-->
            </div>
        </div>
    </div>
</section>
<!--FIN Contenido-->