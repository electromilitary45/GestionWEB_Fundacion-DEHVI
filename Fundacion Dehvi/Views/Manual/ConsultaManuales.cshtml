@model Tuple<IEnumerable<Fundacion_Dehvi.Entities.Manual_Ent>, IEnumerable<Fundacion_Dehvi.Entities.DepartamentoEnt>>
@{
    ViewBag.Title = "Manuales";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var idRol = byte.Parse(Session["idRol"].ToString());

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            case 2://jefaruta
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            default: //todos sin permisos
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
        }
    }
}

<!--INICIO: Page Tittle-->
<section id="page-title" class="text-light" style="background-image: url('../../Src/image/imagenes/banner 5.png');; background-size: cover; background-position: center center;">
    <div class="bg-overlay" data-style="1"></div>

    <div class="container">
        <div class="breadcrumb text-dark">
            <ul>
                <li><a href="@Url.Action("Index","Home")">Home</a> </li>
                <li><a href="@Url.Action("ConsultaManuales","Manual")">Manuales</a> </li>
            </ul>
        </div>
        <div class="page-title">
            <h2 style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); padding: 12px; text-align: center;">Manuales</h2>
        </div>
    </div>
</section>

<!--FIN: Page Tittle-->
<!--INICIO: Page Content-->
<section id="page-content">
    <div class="container">
        <div class="row"></div>

        <!--INICIO: Filtro-->
        <nav class="grid-filter gf-creative center" data-layout="#portfolio">
            <ul>
                <li class="active"><a href="#" data-category="*">Mostrar Todos</a></li>
                @foreach (var dep in Model.Item2)
                {
                    <li><a href="#" data-category=".ct-@dep.idDepartamento">@dep.nombre</a></li>
                }
            </ul>
        </nav>
        <!--FIN: Filtro-->
        <!--INICIO: PORTFOLIO-->
        <div id="portfolio" class="grid-layout portfolio-4-columns">
            @foreach (var man in Model.Item1)
            {
                <div class="portfolio-item no-overlay img-zoom ct-@man.idDepartamento">
                    <div class="portfolio-item-wrap">
                        <div class="row team-members team-members-shadow m-b-40">

                            <div class="col-md-9">
                                <div class="team-member" style="cursor: pointer;">
                                    <div class="team-image">
                                        @if (idRol == 1 && idRol == 2)
                                        {
                                            <a href="@Url.Action("PerfilManual", "Manual", new { q = man.idManual })"><img src="~/Src/image/Archivos/archivo-predeterminado.png" alt="" style="object-fit: cover; height: 180px; width: 100%;"></a>
                                        }
                                        else
                                        {
                                            <a href="@Url.Action("PerfilManualAdmin", "Manual", new { q = man.idManual })"><img src="~/Src/image/Archivos/archivo-predeterminado.png" alt="" style="object-fit: cover; height: 180px; width: 100%;"></a>

                                        }
                                        
                                    </div>
                                    <div class="team-desc">
                                        <div class="item-container">
                                            <a href="portfolio-page-grid-gallery.html">
                                                <h6>@man.nombre</h6>
                                                <span>Creacion: @man.fechaCreacion</span>
                                            </a>
                                        </div>
                                        
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
        <!--FIN: PORTFOLIO-->
    </div>
</section>
<!--FIN: Page Content-->
