@model IEnumerable<Fundacion_Dehvi.Entities.DepartamentoEnt>
@{
    ViewBag.Title = "ListaDepartasAdmin";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
}
<link href="~/Src/css/custom.css" rel="stylesheet">

<section id="page-title" class="text-light" style="background-image: url(../../Src/image/1.png); background-size: cover; background-position: center center;">
    <div class="container">
        <div class="breadcrumb">
            <ul>
                <li><a href="@Url.Action("Index","Home")">Home</a> </li>
                <li><a href="@Url.Action("ListaDeparta","Departamento")">Departamentos</a> </li>
                <li class="active"><a href="#">Listado Admin</a> </li>
            </ul>
        </div>
        <div class="page-title">
            <h2 style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); padding: 12px; text-align: center;">Lista de Sectores</h2>
        </div>
    </div>
</section>


<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">
            <!-- post content -->
            <div class="content col-lg-9">
                @* TABLA *@
                <div class="row">
                    <div class="col-lg-12">
                        <div id="datatable1_wrapper" class="dataTables_wrapper dt-bootstrap4">
                            <div class="row">
                                <div class="col-sm-12">
                                    <table id="datatable1" class="table table-bordered table-striped table-hover dataTable" style="width: 100%;" role="grid" aria-describedby="datatable_info">
                                        <thead>
                                            <tr role="row">
                                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Nombre del Sector: activar para ordenar columnas ascendente" style="width: 200px;">Nombre del Sector</th>
                                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Cantidad de Procedimientos: activar para ordenar columnas ascendente" style="width: 250px;">Cantidad de Procedimientos</th>
                                                <th class="sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Cantidad de Empleados: activar para ordenar columnas ascendente" style="width: 250px; ">Cantidad de Empleados</th>
                                                <th class="sorting center" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Estado: activar para ordenar columnas ascendente" style="width: 100px;">Estado</th>
                                                <th class="noExport sorting" tabindex="0" aria-controls="datatable" rowspan="1" colspan="1" aria-label="Acciones: activar para ordenar columnas ascendente" style="width: 100px;">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model)
                                            {
                                                <tr role="row" class="odd">
                                                    <td> @item.nombre</td>
                                                    <td> @item.nombre</td>
                                                    <td> @item.nombre</td>
                                                    <td>
                                                        @if (item.estado == true)
                                                        {
                                                            <span class="badge badge-pill badge-success">Activo</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-pill badge-danger">Inactivo</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a class="ml-2" href="@Url.Action("ActualizarDepa", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Editar"><i class="icon-edit" style="font-size: 18px;"></i></a>
                                                        @if (item.estado == true)
                                                        {
                                                            <a class="ml-2" href="@Url.Action("EstadoDepartamento", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Desactivar"><i class="icon-toggle-right" style="font-size: 18px;"></i></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="ml-2" href="@Url.Action("EstadoDepartamento", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Activar"><i class="icon-toggle-left" style="font-size: 18px;"></i></a>
                                                        }
                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12 col-md-5">
                                        <div class="dataTables_info" id="datatable_info" role="status" aria-live="polite"></div>
                                    </div>
                                    <div class="col-sm-12 col-md-7">
                                        <div class="dataTables_paginate paging_simple_numbers" id="datatable_paginate">
                                            <ul class="pagination"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            </div>
                            </div>
                            </div>

                        </div>
                        <!-- end: post content -->
                        <!-- Sidebar-->
                        <div class="sidebar col-lg-3">
                            <!--Tabs with Posts-->
                            <div class="widget ">
                                <div class="row mb-3">
                                    <div class="col-lg-12 text-left">
                                        <a href="@Url.Action("CrearDepartamento", "Departamento")" class="btn btn-light">Agregar Departamento</a>
                                    </div>
                                    <div id="export_buttons" class="col-lg-12 text-left"></div>
                                </div>
                            </div>
                        </div>
                        <!--End: Tabs with Posts-->
                    </div>
                    <!-- end: Sidebar-->
                </div>
</section> <!-- end: Content -->