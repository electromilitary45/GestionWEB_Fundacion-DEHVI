@model IEnumerable<Fundacion_Dehvi.Entities.DepartamentoEnt>
@{
    ViewBag.Title = "Lista Administrativa";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";

    var idRol = byte.Parse(Session["idRol"].ToString());

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            case 2://jefaruta
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
            default: //todos sin permisos
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;
        }
    }
}
<link href="~/Src/css/custom.css" rel="stylesheet">

<section id="page-title" class="text-light" style="background-image: url(../../Src/image/imagenes/Departamentos.png); background-size: cover; background-position: center center;">
    <div class="container">
        <div class="breadcrumb">
            <ul>
                <li><a href="@Url.Action("Index","Home")">Home</a> </li>
                <li><a href="@Url.Action("ListaDeparta","Departamento")">Departamentos</a> </li>
                <li class="active"><a href="#">Listado Admin</a> </li>
            </ul>
        </div>
        <div class="page-title">
            <h2 style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); padding: 12px; text-align: center;">Lista de Sectores</h2>
        </div>
    </div>
</section>


<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">
            <!-- post content -->
            <div class="content col-lg-9">
                @* TABLA *@
                <div class="row">
                    <div class="col-lg-12">
                        <div id="datatable1_wrapper" class="dataTables_wrapper dt-bootstrap4" >
                            <div class="row">
                                <div class="col-sm-12">
                                    <table class="table table-hover">
                                        <thead>
                                            <tr class="table-secondary">
                                                <th scope="row">Nombre del Sector</th>
                                                <th scope="row">Cantidad de Procedimientos</th>
                                                <th scope="row">Cantidad de Empleados</th>
                                                <th scope="row">Estado</th>
                                                <th scope="row">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>

                                            @foreach (var item in Model)
                                            {
                                                <tr role="row" class="odd">
                                                    <td> @item.nombre</td>
                                                    <td> @item.nombre</td>
                                                    <td> @item.nombre</td>
                                                    <td>
                                                        @if (item.estado == true)
                                                        {
                                                            <span class="badge badge-pill badge-success">Activo</span>
                                                        }
                                                        else
                                                        {
                                                            <span class="badge badge-pill badge-danger">Inactivo</span>
                                                        }
                                                    </td>
                                                    <td>
                                                        <a class="ml-2" href="@Url.Action("ActualizarDepa", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Editar"><i class="icon-eye"></i></a>
                                                        @if (item.estado == true)
                                                        {
                                                            <a class="ml-2" href="@Url.Action("EstadoDepartamento", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Desactivar"><i class="icon-toggle-right"></i></a>
                                                        }
                                                        else
                                                        {
                                                            <a class="ml-2" href="@Url.Action("EstadoDepartamento", "Departamento", new { q = item.idDepartamento })" data-toggle="tooltip" data-original-title="Activar"><i class="icon-toggle-left"></i></a>
                                                        }
                                                    </td>
                                                </tr>
                                            }

                                        </tbody>
                                    </table>
                                </div>
                                <div class="row">
                                    <div class="col-sm-12 col-md-5">
                                        <div class="dataTables_info" id="datatable_info" role="status" aria-live="polite"></div>
                                    </div>
                                    <div class="col-sm-12 col-md-7">
                                        <div class="dataTables_paginate paging_simple_numbers" id="datatable_paginate">
                                            <ul class="pagination"></ul>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
            <!-- end: post content -->
            <!-- Sidebar-->
            <div class="sidebar col-lg-3">
                <!--Tabs with Posts-->
                <div class="widget ">
                    <div class="row mb-3">
                        <div class="col-lg-12 text-left">
                            <a href="@Url.Action("CrearDepartamento", "Departamento")" class="btn" style="background-color: #59B2E9; border-color: #59B2E9 ">Agregar Departamento</a>
                        </div>
                        <div id="export_buttons" class="col-lg-12 text-left"></div>
                    </div>
                </div>
            </div>
            <!--End: Tabs with Posts-->
        </div>
        <!-- end: Sidebar-->
    </div>
</section> <!-- end: Content -->