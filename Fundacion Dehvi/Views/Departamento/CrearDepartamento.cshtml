@model Fundacion_Dehvi.Entities.DepartamentoEnt
@{
    ViewBag.Title = "Agregar Departamento";

    byte idRol;
    byte.TryParse(Session["idRol"]?.ToString(), out idRol);

    if (Session["idUsuario"] != null)
    {
        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;

            default: //empleaods
                Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
                break;
        }
    }
}

<link href="~/Src/css/custom.css" rel="stylesheet">

<section id="page-title" class="text-light" style="background-image: url('../../Src/image/imagenes/banner 2.png'); background-size: cover; background-position: center center;">
    <div class="container">
        <div class="breadcrumb">
            <ul>
                <li><a href="@Url.Action("Index","Home")">Home</a> </li>
                <li><a href="@Url.Action("ListaDeparta","Departamento")">Departamentos</a> </li>
                <li class="active"><a href="#">Agregar Departamento</a> </li>
            </ul>
        </div>
        <div class="page-title">
            <h2 style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); padding: 12px; text-align: center;">Agregar Departamento</h2>
        </div>
    </div>
</section>

<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">
            <!-- post content -->
            <div class="content col-lg-9">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- FORMS -->
                        <div class="card">
                            <div class="card-body">
                                @if (ViewBag.mensaje != null)
                                {
                                    <div class="alert alert-primary" role="alert">
                                        @ViewBag.mensaje
                                    </div>
                                }

                                @using (Html.BeginForm("CrearDepartamento", "Departamento", FormMethod.Post, new { @class = "form-validate", @novalidate = "novalidate" }))
                                {
                                    <div class="form-row">
                                        <!-- Nombre Departamento -->
                                        <div class="form-group col-md-6">
                                            <label for="nombre">Nombre del Departamento</label>
                                            @Html.TextBoxFor(m => m.nombre, new { @class = "form-control", @required = "", @placeholder = "Ingrese el nombre del departamento:" })
                                        </div>

                                    </div>
                                    <input type="submit" class="btn m-t-30 mt-3" value="Agregar Departamento">
                                }
                            </div>
                        </div>
                        <!-- FIN FORMS -->
                    </div>
                </div>

            </div>
            <!-- end: post content -->
            <!-- Sidebar-->
            <div class="sidebar col-lg-3">
                <!--Tabs with Posts-->
                <div class="widget ">
                    <div class="row mb-3">
                        <div class="col-lg-12 text-left">
                            <a href="@Url.Action("ListaDepartasAdmin", "Departamento")" class="btn" style="background-color: #59B2E9; border-color: #59B2E9 ">Lista de Departamentos</a>
                        </div>
                    </div>
                </div>
            </div>
            <!--End: Tabs with Posts-->
        </div>
        <!-- end: Sidebar-->
    </div>
</section> <!-- end: Content -->