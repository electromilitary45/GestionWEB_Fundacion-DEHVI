@model Tuple<Fundacion_Dehvi.Entities.DepartamentoEnt, IEnumerable<Fundacion_Dehvi.Entities.ProcedimientosEnt>>

@{
    ViewBag.Title = "Perfil del Departamento";
    Layout = "~/Views/Shared/_LayoutAdmin.cshtml";


    byte idRol;
    byte.TryParse(Session["idRol"]?.ToString(), out idRol);


    if (Session["idUsuario"] != null)
    {

        switch (idRol)
        {
            case 1: //admin
                Layout = "~/Views/Shared/_LayoutAdmin.cshtml";
                break;

            default: //empleaods
                Layout = "~/Views/Shared/_LayoutEmpleado.cshtml";
                break;
        }
    }
    var departas = Model.Item2.Where(item => item.idDepartamento == Model.Item1.idDepartamento).ToList();

}

<link href="~/Src/css/custom.css" rel="stylesheet">

<section id="page-title" class="text-light" style="background-image: url('../../Src/image/imagenes/banner 2.png'); background-size: cover; background-position: center center;">
    <div class="container">
        <div class="breadcrumb">
            <ul>
                <li><a href="@Url.Action("Index","Home")">Home</a> </li>
                <li><a href="@Url.Action("ListaDeparta","Departamento")">Departamentos</a> </li>
                <li class="active"><a href="#">Listado Procedimientos</a> </li>
            </ul>
        </div>
        <div class="page-title">
            <h2 style="text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5); padding: 12px; text-align: center;">@Html.DisplayFor(m => m.Item1.nombre)</h2>
        </div>
    </div>
</section>

<section id="page-content" class="sidebar-left">
    <div class="container">
        <div class="row">
            <!-- post content -->
            <div class="content col-lg-9">
                <div class="row">
                    <div class="col-lg-12">
                        <!-- Grid de los Procedimientos -->

                        <div class="row team-members team-members-shadow m-b-40">
                            @if (Model != null)
                            {
                                foreach (var item in Model.Item2)
                                {
                                    if (item.idDepartamento == Model.Item1.idDepartamento)
                                    {
                                        <div class="col-md-5">
                                            <div class="team-member" onclick="location.href='@Url.Action("PerfilProce", "Procedimiento", new { q = item.idProcedimiento })';" style="cursor: pointer;">
                                                <div class="team-image">
                                                    <img src="~/Src/image/imagenes/3.png" style="object-fit: cover; height: 180px; width: 100%;">
                                                </div>
                                                <div class="team-desc">
                                                    <div class="item-container">
                                                        <span>@item.codProcedimiento</span>
                                                        @if (Session["idRol"] != null && idRol == 1)
                                                        {
                                                            <a href="@Url.Action("ActualizarProce", "Procedimiento", new { q = item.idProcedimiento })">
                                                                <i class="icon-edit"></i>
                                                            </a>
                                                            if (item.estado == true)
                                                            {
                                                                <a class="ml-2" href="@Url.Action("EstadoProce", "Procedimiento", new { q = item.idProcedimiento })" data-toggle="tooltip" data-original-title="Desactivar"><i class="icon-toggle-right"></i></a>
                                                            }
                                                            else
                                                            {
                                                                <a class="ml-2" href="@Url.Action("EstadoProce", "Procedimiento", new { q = item.idProcedimiento })" data-toggle="tooltip" data-original-title="Activar"><i class="icon-toggle-left"></i></a>

                                                            }
                                                        }
                                                        </div>
                                                    <h5>@item.nombre</h5>
                                                    <p style="font-size:13px">@item.descripcion</p>
                                                    <span>Fecha de Creación</span>
                                                    <p>@item.fechaCreacion.ToString("dd/MM/yyyy")</p>
                                                </div>
                                            </div>
                                        </div>

                                    }
                                }
                            }
                            @if(departas.Count() == 0)
                            {
                                <div class="alert-container" style="display: flex; align-items: center; justify-content: center; padding: 20px; background-color: #f0f8ff; border: 1px solid #b8daff; border-radius: 10px;">
                                    <img src="~/Src/image/imagenes/a.png" style="width: 200px; height: auto; margin-right: 20px;">
                                    <div role="alert" class="alert alert-info" style="flex: 1; background-color: #d1ecf1; color: #0c5460; border-color: #bee5eb; padding: 20px; border-radius: 10px;">
                                        <h4 style="text-align:center;  margin-top: 0; text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);">¡Oops! No se encontraron procedimientos</h4>
                                    </div>
                                </div>
                            }
                        </div>


                        <!-- Fin del Grid -->
                    </div>
                </div>
            </div>
            <!-- end: post content -->
            <!-- Sidebar-->
            <div class="sidebar col-lg-3">
                <!--Tabs with Posts-->
                @if (idRol == 1 || idRol == 2)
                {
                    <div class="widget">
                        <div class="row mb-3">
                            <div class="col-lg-12 text-left">
                                <a href="@Url.Action("CrearProcedimientoAdminJefa", "Procedimiento", new {q=Model.Item1.idDepartamento})" class="btn" style="background-color: #59B2E9; border-color: #59B2E9">Agregar Procedimiento</a>
                            </div>
                        </div>
                    </div>
                }
            </div>
            <!--End: Tabs with Posts-->
        </div>
        <!-- end: Sidebar-->
    </div>
</section> <!-- end: Content -->